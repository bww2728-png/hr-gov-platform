// HR Governance & Institutional Transformation Platform
// 38+ tables implementing 8 engines + RBAC + 42 maturity dimensions + 52-week roadmap

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS - Centralized type definitions
// =====================================================================

enum UserStatus {
  active
  inactive
  locked
}

enum EmploymentStatus {
  active
  notice_period
  on_leave
  terminated
}

enum ContractType {
  full_time
  part_time
  contract
  intern
  consultant
}

enum CandidateStage {
  applied
  screening
  interview
  assessment
  offer
  hired
  rejected
  withdrawn
}

enum DocumentStatus {
  draft
  in_review
  approved
  published
  archived
}

enum WorkflowStatus {
  running
  approved
  rejected
  escalated
  cancelled
}

enum ViolationSeverity {
  info
  warning
  critical
}

enum ViolationStatus {
  open
  in_progress
  resolved
  false_positive
}

enum RiskStatus {
  identified
  assessed
  mitigated
  accepted
  closed
}

enum RoadmapStatus {
  pending
  in_progress
  done
  blocked
  skipped
}

enum KPIPeriod {
  daily
  weekly
  monthly
  quarterly
  yearly
}

// =====================================================================
// 1. IDENTITY & ACCESS (RBAC + ABAC)
// =====================================================================

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  nameAr      String   @map("name_ar")
  nameEn      String   @map("name_en")
  description String?
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model PermissionCatalog {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([module])
  @@map("permission_catalog")
}

model User {
  id                 String          @id @default(uuid())
  username           String          @unique
  fullNameAr         String          @map("full_name_ar")
  fullNameEn         String?         @map("full_name_en")
  email              String?         @unique
  phone              String?
  passwordHash       String          @map("password_hash")
  roleId             Int             @map("role_id")
  role               Role            @relation(fields: [roleId], references: [id])
  employeeId         String?         @unique @map("employee_id")
  employee           Employee?       @relation(fields: [employeeId], references: [id])
  status             UserStatus      @default(active)
  mustChangePassword Boolean         @default(true) @map("must_change_password")
  initialPasswordEnc String?         @map("initial_password_enc")
  passwordIssuedAt   DateTime?       @map("password_issued_at")
  mfaEnabled         Boolean         @default(false) @map("mfa_enabled")
  tokenVersion       Int             @default(0) @map("token_version")
  lastLoginAt        DateTime?       @map("last_login_at")
  failedLoginCount   Int             @default(0) @map("failed_login_count")
  lockedUntil        DateTime?       @map("locked_until")
  languagePref       String          @default("ar") @map("language_pref")
  deletedAt          DateTime?       @map("deleted_at")
  auditLogs          AuditLog[]
  sessions           UserSession[]
  scopes             UserScope[]
  changeRequests     ChangeRequest[]
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserScope {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopeType  String   @map("scope_type") // region, branch, department
  scopeId    Int      @map("scope_id")
  canRead    Boolean  @default(true) @map("can_read")
  canWrite   Boolean  @default(false) @map("can_write")
  canApprove Boolean  @default(false) @map("can_approve")
  canDelete  Boolean  @default(false) @map("can_delete")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@map("user_scopes")
}

model AuditLog {
  id            BigInt   @id @default(autoincrement())
  userId        String?  @map("user_id")
  user          User?    @relation(fields: [userId], references: [id])
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  beforeJson    Json?    @map("before_json")
  afterJson     Json?    @map("after_json")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  correlationId String?  @map("correlation_id")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =====================================================================
// 2. HR CORE ENGINE - Master records
// =====================================================================

model Region {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  nameAr      String   @map("name_ar")
  nameEn      String   @map("name_en")
  countryCode String   @map("country_code")
  branches    Branch[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("regions")
}

model Branch {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  nameAr       String       @map("name_ar")
  nameEn       String       @map("name_en")
  regionId     Int          @map("region_id")
  region       Region       @relation(fields: [regionId], references: [id])
  timezone     String       @default("Asia/Riyadh")
  workingHours String       @default("08:00-17:00") @map("working_hours")
  isActive     Boolean      @default(true) @map("is_active")
  departments  Department[]
  employees    Employee[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([regionId])
  @@map("branches")
}

model Department {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  nameAr         String       @map("name_ar")
  nameEn         String       @map("name_en")
  parentId       Int?         @map("parent_id")
  parent         Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children       Department[] @relation("DeptHierarchy")
  headEmployeeId String?      @map("head_employee_id")
  branchId       Int?         @map("branch_id")
  branch         Branch?      @relation(fields: [branchId], references: [id])
  positions      Position[]
  employees      Employee[]
  sections       Section[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([branchId])
  @@map("departments")
}

model Position {
  id         Int        @id @default(autoincrement())
  code       String     @unique
  titleAr    String     @map("title_ar")
  titleEn    String     @map("title_en")
  deptId     Int        @map("dept_id")
  department Department @relation(fields: [deptId], references: [id])
  level      Int        @default(1)
  minSalary  Decimal?   @map("min_salary") @db.Decimal(12, 2)
  maxSalary  Decimal?   @map("max_salary") @db.Decimal(12, 2)
  isVacant   Boolean    @default(true) @map("is_vacant")
  employees  Employee[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([deptId])
  @@map("positions")
}

model Employee {
  id                 String               @id @default(uuid())
  employeeNumber     String               @unique @map("employee_number")
  fullNameAr         String               @map("full_name_ar")
  fullNameEn         String?              @map("full_name_en")
  nationalId         String?              @unique @map("national_id")
  nationality        String?
  residentType       String               @default("saudi") @map("resident_type") // saudi, expat
  gender             String?
  maritalStatus      String?              @map("marital_status")
  dobGregorian       DateTime?            @map("dob_gregorian")
  dobHijri           String?              @map("dob_hijri")
  email              String?
  phone              String?
  address            String?
  hireDate           DateTime             @map("hire_date")
  contractEndDate    DateTime?            @map("contract_end_date")
  contractType       ContractType         @default(full_time)
  employmentStatus   EmploymentStatus     @default(active) @map("employment_status")
  probationEndDate   DateTime?            @map("probation_end_date")
  branchId           Int                  @map("branch_id")
  branch             Branch               @relation(fields: [branchId], references: [id])
  deptId             Int                  @map("dept_id")
  department         Department           @relation(fields: [deptId], references: [id])
  positionId         Int                  @map("position_id")
  position           Position             @relation(fields: [positionId], references: [id])
  managerId          String?              @map("manager_id")
  manager            Employee?            @relation("ReportsTo", fields: [managerId], references: [id])
  reports            Employee[]           @relation("ReportsTo")
  salary             Decimal              @default(0) @db.Decimal(12, 2)
  currency           String               @default("SAR")
  bankAccount        String?              @map("bank_account")
  bankName           String?              @map("bank_name")
  iban               String?
  profilePhoto       String?              @map("profile_photo")
  notes              String?
  // ==== مواءمة الوثيقة 2: أعمدة القوائم المنسدلة الـ 21 ====
  sectionId          Int?                 @map("section_id")
  section            Section?             @relation(fields: [sectionId], references: [id])
  sponsorCode        String?              @map("sponsor_code") // الكفيل (lookup: sponsor)
  visaTypeCode       String?              @map("visa_type_code") // نوع التأشيرة (lookup: visa_type)
  jobCategoryCode    String?              @map("job_category_code") // الفئة الوظيفية (lookup: job_category)
  qualificationCode  String?              @map("qualification_code") // المؤهل (lookup: education_level)
  housingAllowance   Decimal              @default(0) @map("housing_allowance") @db.Decimal(12, 2)
  transportAllowance Decimal              @default(0) @map("transport_allowance") @db.Decimal(12, 2)
  otherAllowances    Decimal              @default(0) @map("other_allowances") @db.Decimal(12, 2)
  passportNumber     String?              @map("passport_number")
  iqamaNumber        String?              @map("iqama_number")
  deletedAt          DateTime?            @map("deleted_at")
  user               User?
  history            EmployeeHistory[]
  onboardingTasks    OnboardingTask[]
  exitInterview      ExitInterview?
  contracts          Contract[]
  transfers          Transfer[]
  promotions         Promotion[]
  qiwaRequests       QiwaRequest[]
  ledgerEntries      PayrollLedgerEntry[]
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([branchId])
  @@index([deptId])
  @@index([managerId])
  @@index([employmentStatus])
  @@index([residentType])
  @@map("employees")
}

model EmployeeHistory {
  id            Int      @id @default(autoincrement())
  employeeId    String   @map("employee_id")
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  changeType    String   @map("change_type") // promotion, transfer, salary_change, status_change
  beforeJson    Json?    @map("before_json")
  afterJson     Json     @map("after_json")
  effectiveDate DateTime @map("effective_date")
  approvedById  String?  @map("approved_by_id")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([employeeId])
  @@index([changeType])
  @@map("employee_history")
}

// =====================================================================
// 3. LIFECYCLE ENGINE - Recruitment + Onboarding + Exit
// =====================================================================

model JobPosting {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  titleAr      String        @map("title_ar")
  titleEn      String        @map("title_en")
  description  String?
  branchId     Int?          @map("branch_id")
  deptId       Int?          @map("dept_id")
  status       String        @default("draft") // draft, open, on_hold, closed
  openings     Int           @default(1)
  publishedAt  DateTime?     @map("published_at")
  closedAt     DateTime?     @map("closed_at")
  createdById  String        @map("created_by_id")
  applications Application[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([branchId])
  @@map("job_postings")
}

model Candidate {
  id           Int           @id @default(autoincrement())
  fullNameAr   String        @map("full_name_ar")
  fullNameEn   String?       @map("full_name_en")
  email        String?
  phone        String?
  source       String        @default("portal") // portal, referral, agency, social
  resumeUrl    String?       @map("resume_url")
  parsedData   Json?         @map("parsed_data")
  biasFlags    Json?         @map("bias_flags")
  notes        String?
  applications Application[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([email])
  @@index([source])
  @@map("candidates")
}

model Application {
  id          Int            @id @default(autoincrement())
  candidateId Int            @map("candidate_id")
  candidate   Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  postingId   Int            @map("posting_id")
  posting     JobPosting     @relation(fields: [postingId], references: [id], onDelete: Cascade)
  stage       CandidateStage @default(applied)
  score       Float?
  biasScore   Float?         @map("bias_score")
  appliedAt   DateTime       @default(now()) @map("applied_at")
  closedAt    DateTime?      @map("closed_at")
  interviews  Interview[]
  offer       Offer?

  @@unique([candidateId, postingId])
  @@index([stage])
  @@index([postingId])
  @@map("applications")
}

model Interview {
  id            Int         @id @default(autoincrement())
  applicationId Int         @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime    @map("scheduled_at")
  durationMins  Int         @default(60) @map("duration_mins")
  panelJson     Json?       @map("panel_json")
  feedbackJson  Json?       @map("feedback_json")
  decision      String? // strong_hire, hire, no_hire, strong_no_hire
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([applicationId])
  @@index([scheduledAt])
  @@map("interviews")
}

model Offer {
  id            Int         @id @default(autoincrement())
  applicationId Int         @unique @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  salary        Decimal     @db.Decimal(12, 2)
  currency      String      @default("SAR")
  benefits      Json?
  startDate     DateTime    @map("start_date")
  status        String      @default("draft") // draft, sent, accepted, declined, expired
  sentAt        DateTime?   @map("sent_at")
  respondedAt   DateTime?   @map("responded_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("offers")
}

model OnboardingTask {
  id          Int       @id @default(autoincrement())
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taskCode    String    @map("task_code")
  titleAr     String    @map("title_ar")
  titleEn     String?   @map("title_en")
  status      String    @default("pending") // pending, in_progress, done, blocked
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  assigneeId  String?   @map("assignee_id")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([employeeId])
  @@index([status])
  @@map("onboarding_tasks")
}

model ExitInterview {
  id                Int       @id @default(autoincrement())
  employeeId        String    @unique @map("employee_id")
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  conductedAt       DateTime? @map("conducted_at")
  conductedById     String?   @map("conducted_by_id")
  primaryReason     String?   @map("primary_reason")
  fiveWhysJson      Json?     @map("five_whys_json")
  knowledgeTransfer Json?     @map("knowledge_transfer")
  feedbackJson      Json?     @map("feedback_json")
  satisfactionScore Int?      @map("satisfaction_score")
  rehireEligible    Boolean   @default(true) @map("rehire_eligible")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("exit_interviews")
}

// =====================================================================
// 4. KNOWLEDGE MANAGEMENT ENGINE
// =====================================================================

model KnowledgeDocument {
  id                Int            @id @default(autoincrement())
  code              String         @unique
  titleAr           String         @map("title_ar")
  titleEn           String?        @map("title_en")
  contentMarkdown   String         @map("content_markdown") @db.Text
  category          String // sop, guide, template, lesson_learned
  tags              Json           @default("[]")
  authorId          String         @map("author_id")
  status            DocumentStatus @default(draft)
  version           Int            @default(1)
  parentVersionId   Int?           @map("parent_version_id")
  relatedDecisionId Int?           @map("related_decision_id")
  publishedAt       DateTime?      @map("published_at")
  archivedAt        DateTime?      @map("archived_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@index([category])
  @@map("knowledge_documents")
}

model DecisionRecord {
  id                   Int      @id @default(autoincrement())
  code                 String   @unique
  titleAr              String   @map("title_ar")
  contextMarkdown      String   @map("context_markdown") @db.Text
  decisionMarkdown     String   @map("decision_markdown") @db.Text
  consequencesMarkdown String?  @map("consequences_markdown") @db.Text
  decidedById          String   @map("decided_by_id")
  decidedAt            DateTime @map("decided_at")
  relatedDocsJson      Json?    @map("related_docs_json")
  // Hash chain for immutability
  previousHash         String?  @map("previous_hash")
  currentHash          String   @map("current_hash")
  status               String   @default("active") // active, superseded, revoked
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([decidedAt])
  @@map("decision_records")
}

model Policy {
  id              Int            @id @default(autoincrement())
  code            String         @unique
  titleAr         String         @map("title_ar")
  titleEn         String         @map("title_en")
  contentMarkdown String         @map("content_markdown") @db.Text
  jurisdiction    String         @default("SA") // SA, AE, EG, GLOBAL
  effectiveDate   DateTime       @map("effective_date")
  expiryDate      DateTime?      @map("expiry_date")
  autoRenewal     Boolean        @default(false) @map("auto_renewal")
  sourceUrl       String?        @map("source_url")
  version         Int            @default(1)
  status          DocumentStatus @default(draft)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([jurisdiction])
  @@index([status])
  @@map("policies")
}

// =====================================================================
// 5. WORKFLOW ENGINE
// =====================================================================

model WorkflowDefinition {
  id             Int                @id @default(autoincrement())
  code           String             @unique
  nameAr         String             @map("name_ar")
  nameEn         String             @map("name_en")
  description    String?
  definitionJson Json               @map("definition_json")
  version        Int                @default(1)
  isActive       Boolean            @default(true) @map("is_active")
  instances      WorkflowInstance[]
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@map("workflow_definitions")
}

model WorkflowInstance {
  id           Int                @id @default(autoincrement())
  definitionId Int                @map("definition_id")
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id])
  entityType   String             @map("entity_type")
  entityId     String             @map("entity_id")
  currentStep  String             @map("current_step")
  status       WorkflowStatus     @default(running)
  startedAt    DateTime           @default(now()) @map("started_at")
  closedAt     DateTime?          @map("closed_at")
  steps        WorkflowStep[]

  @@index([entityType, entityId])
  @@index([status])
  @@map("workflow_instances")
}

model WorkflowStep {
  id          Int              @id @default(autoincrement())
  instanceId  Int              @map("instance_id")
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepCode    String           @map("step_code")
  stepNameAr  String           @map("step_name_ar")
  assigneeId  String?          @map("assignee_id")
  decision    String? // approved, rejected, delegated
  decidedAt   DateTime?        @map("decided_at")
  comments    String?
  slaMinutes  Int              @default(60) @map("sla_minutes")
  slaDeadline DateTime         @map("sla_deadline")
  escalatedAt DateTime?        @map("escalated_at")
  orderIndex  Int              @map("order_index")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([instanceId])
  @@index([assigneeId])
  @@map("workflow_steps")
}

// =====================================================================
// 6. COMPLIANCE ENGINE
// =====================================================================

model ComplianceRule {
  id           Int                   @id @default(autoincrement())
  code         String                @unique
  nameAr       String                @map("name_ar")
  nameEn       String                @map("name_en")
  description  String?
  jurisdiction String                @default("SA")
  ruleJson     Json                  @map("rule_json")
  severity     ViolationSeverity     @default(warning)
  isActive     Boolean               @default(true) @map("is_active")
  violations   ComplianceViolation[]
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@index([jurisdiction])
  @@map("compliance_rules")
}

model ComplianceViolation {
  id           Int               @id @default(autoincrement())
  ruleId       Int               @map("rule_id")
  rule         ComplianceRule    @relation(fields: [ruleId], references: [id])
  entityType   String            @map("entity_type")
  entityId     String            @map("entity_id")
  severity     ViolationSeverity
  status       ViolationStatus   @default(open)
  detectedAt   DateTime          @default(now()) @map("detected_at")
  resolvedById String?           @map("resolved_by_id")
  resolvedAt   DateTime?         @map("resolved_at")
  notes        String?
  details      Json?

  @@index([status])
  @@index([severity])
  @@index([entityType, entityId])
  @@map("compliance_violations")
}

model DocumentExpiry {
  id           Int      @id @default(autoincrement())
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  documentType String   @map("document_type")
  documentRef  String?  @map("document_ref")
  expiryDate   DateTime @map("expiry_date")
  alert30Sent  Boolean  @default(false) @map("alert_30_sent")
  alert7Sent   Boolean  @default(false) @map("alert_7_sent")
  alert0Sent   Boolean  @default(false) @map("alert_0_sent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([expiryDate])
  @@index([entityType, entityId])
  @@map("document_expiries")
}

// =====================================================================
// 7. OPERATIONAL EXCELLENCE + MATURITY + 5 WHYS
// =====================================================================

model ProcessKPI {
  id              Int       @id @default(autoincrement())
  processCode     String    @map("process_code")
  nameAr          String    @map("name_ar")
  nameEn          String    @map("name_en")
  description     String?
  targetValue     Float     @map("target_value")
  currentValue    Float     @default(0) @map("current_value")
  measurementUnit String    @map("measurement_unit")
