  fromBranchId   Int?      @map("from_branch_id")
  fromDeptId     Int?      @map("from_dept_id")
  fromSectionId  Int?      @map("from_section_id")
  fromPositionId Int?      @map("from_position_id")
  toBranchId     Int?      @map("to_branch_id")
  toDeptId       Int?      @map("to_dept_id")
  toSectionId    Int?      @map("to_section_id")
  toPositionId   Int?      @map("to_position_id")
  transferDate   DateTime  @map("transfer_date")
  memo           String?
  reason         String?
  status         String    @default("pending") // pending, hr_approved, executed, rejected
  requestedBy    String?   @map("requested_by")
  approvedBy     String?   @map("approved_by")
  executedAt     DateTime? @map("executed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([employeeId])
  @@index([status])
  @@map("transfers")
}

// حركة ترقية (T5)
model Promotion {
  id             Int       @id @default(autoincrement())
  employeeId     String    @map("employee_id")
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromPositionId Int?      @map("from_position_id")
  toPositionId   Int?      @map("to_position_id")
