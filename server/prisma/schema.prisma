// POLICY PARAMETERS ENGINE — مركز قواعد وسياسات العمل (بدون كود)
// =====================================================================

model PolicyParameter {
  id               Int                      @id @default(autoincrement())
  code             String                   @unique // مثل: gosi.employeePct — overtime.multiplier — workHours.weeklyLimit
  category         String // gosi | overtime | workHours | absence | leave | general
  nameAr           String                   @map("name_ar")
  nameEn           String?                  @map("name_en")
  descriptionAr    String?                  @map("description_ar")
  valueType        String                   @default("number") // number | percent | hours | days
  unitAr           String?                  @map("unit_ar")
  minValue         Float?                   @map("min_value")
  maxValue         Float?                   @map("max_value")
  ownerRoles       Json                     @map("owner_roles")
  approverRoles    Json                     @map("approver_roles")
  requiresApproval Boolean                  @default(true) @map("requires_approval")
  version          Int                      @default(1)
  isActive         Boolean                  @default(true) @map("is_active")
  versions         PolicyParameterVersion[]
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@index([category])
  @@map("policy_parameters")
}

model PolicyParameterVersion {
  id              Int             @id @default(autoincrement())
  parameterCode   String          @map("parameter_code")
  parameter       PolicyParameter @relation(fields: [parameterCode], references: [code])
  version         Int
  valueJson       Json            @map("value_json")
  effectiveFrom   DateTime        @map("effective_from")
  reason          String?
  changeRequestId Int?            @map("change_request_id")
  createdBy       String?         @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@unique([parameterCode, version])
  @@index([parameterCode, effectiveFrom])
  @@map("policy_parameter_versions")
}

model FormulaRevision {
  id              Int      @id @default(autoincrement())
  formulaCode     String   @map("formula_code")
  version         Int
  logicJson       Json?    @map("logic_json")
  expressionAr    String?  @map("expression_ar")
  reason          String?
  changeRequestId Int?     @map("change_request_id")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([formulaCode])
  @@map("formula_revisions")
}
