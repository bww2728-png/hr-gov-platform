  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  basicSalary     Decimal   @default(0) @map("basic_salary") @db.Decimal(12, 2)
  housing         Decimal   @default(0) @db.Decimal(12, 2)
  transport       Decimal   @default(0) @db.Decimal(12, 2)
  otherAllowances Decimal   @default(0) @map("other_allowances") @db.Decimal(12, 2)
  status          String    @default("active") // active, expired, renewed, terminated
