  employees  Employee[]
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([deptId])
  @@map("sections")
}

// حركة تحويل موظف (T8) — قبل/بعد + سير عمل
model Transfer {
  id             Int       @id @default(autoincrement())
  employeeId     String    @map("employee_id")
