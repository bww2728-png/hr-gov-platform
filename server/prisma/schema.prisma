  fromSalary     Decimal?  @map("from_salary") @db.Decimal(12, 2)
  toSalary       Decimal?  @map("to_salary") @db.Decimal(12, 2)
  effectiveDate  DateTime  @map("effective_date")
  reason         String?
  status         String    @default("proposed") // proposed, committee_approved, approved, applied, rejected
  proposedBy     String?   @map("proposed_by")
  approvedBy     String?   @map("approved_by")
  appliedAt      DateTime? @map("applied_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([employeeId])
  @@index([status])
  @@map("promotions")
}

// سجل طلبات منصة قوى (T11) — محاكاة داخلية بحدود واضحة
model QiwaRequest {
