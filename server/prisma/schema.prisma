// =====================================================================
// GOVERNANCE LAYER - حوكمة القوائم والمعادلات (Maker-Checker)
// =====================================================================

// فئة قائمة مرجعية + مصفوفة الحوكمة (المالك/المعتمدون) لكل جدول فرعي من الـ 21
model LookupCategory {
  id               Int      @id @default(autoincrement())
  code             String   @unique // nationality, branch, department, section, position, job_category, contract_type, sponsor, visa_type, employee_status, request_status, qualification, eos_reason, request_reason, action_type, action_result, qiwa_change_type, classification_type, request_type, entity, employees
  nameAr           String   @map("name_ar")
  nameEn           String?  @map("name_en")
  source           String   @default("lookup") // lookup (جدول lookups) أو table (كيان حي: branches/departments/employees...)
  sourceTable      String?  @map("source_table") // اسم الجدول الحي إن وُجد
  ownerRoles       Json     @map("owner_roles") // ["hr_specialist"] — من يقترح/يعدّل
  approverRoles    Json     @map("approver_roles") // ["hr_director","finance_manager"] — سلسلة الاعتماد بالترتيب
  requiresApproval Boolean  @default(true) @map("requires_approval")
  sensitive        Boolean  @default(false) // يتطلب أربع عيون (اعتمادين)
  notes            String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("lookup_categories")
}

// طلب تغيير محكوم (قائمة مرجعية / معادلة / هيكل رواتب) — يُطبَّق بعد اكتمال الاعتمادات
model ChangeRequest {
  id            Int       @id @default(autoincrement())
  kind          String // lookup, formula, salary_structure, employee
  targetKey     String    @map("target_key") // category:code أو formula code
  action        String // create, update, deactivate
  payloadJson   Json      @map("payload_json") // القيم الجديدة المقترحة
  beforeJson    Json?     @map("before_json") // القيم الحالية قبل التغيير
  reason        String // إلزامي — مبدأ البصمة والتوثيق
  proposedBy    String    @map("proposed_by")
  proposer      User      @relation(fields: [proposedBy], references: [id])
  approverChain Json      @map("approver_chain") // ["hr_director","finance_manager"] لقطة وقت الاقتراح
  currentStage  Int       @default(0) @map("current_stage")
  approvalsJson Json      @default("[]") @map("approvals_json") // [{userId, role, decision, note, at}]
  status        String    @default("pending") // pending, approved, applied, rejected, cancelled
  decidedNote   String?   @map("decided_note")
  appliedAt     DateTime? @map("applied_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([kind, targetKey])
  @@index([proposedBy])
  @@map("change_requests")
}

// تعريف معادلة — 32 معادلة موثقة (النص العربي + الكود + المتغيرات + المثال + الحوكمة)
model FormulaDefinition {
  id            Int      @id @default(autoincrement())
  code          String   @unique // F01..F32
  category      String // salary, service, leave, kpi
  nameAr        String   @map("name_ar")
  nameEn        String?  @map("name_en")
  expressionAr  String   @map("expression_ar") // المعادلة بالعربية كما في الوثيقة
  logicJson     Json?    @map("logic_json") // شجرة القواعد الهيكلية (محرك بدون كود) — تتجاوز الدالة الصلبة عند وجودها
  variablesJson Json     @map("variables_json") // [{key, nameAr, example}]
  exampleJson   Json?    @map("example_json") // {inputs:{}, result}
  ownerRoles    Json     @map("owner_roles")
  approverRoles Json     @map("approver_roles")
  requiresCeo   Boolean  @default(false) @map("requires_ceo") // هيكل الرواتب
  notes         String?
  version       Int      @default(1)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("formula_definitions")
}

