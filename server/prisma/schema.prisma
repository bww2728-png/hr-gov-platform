  renewalOfId     Int?      @map("renewal_of_id")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([status])
  @@index([endDate])
  @@map("contracts")
}

// قسم داخلي يتبع إدارة (الوثيقة تفصل الإدارة عن القسم)
model Section {
